# =============================================================================
# Apache configuration for the Symfony front controller (production)
# This file is shipped to backend/public/.htaccess via scripts/build-release.sh
# Only used when the host runs Apache. Nginx-based hosts ignore it.
# =============================================================================

DirectoryIndex index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nothing under /uploads/ is ever served by the web server directly.
    #
    # This has to come before the "file exists, serve it" rule below, which is
    # what used to hand out cover images: they are ordinary .jpg/.png files
    # sitting in public/uploads/comics/<ownerId>/covers/<comicId>/, so Apache
    # answered for them and the COMIC_VIEW check — including the 18+ gate — was
    # never consulted. Covers are served by /api/comics/cover/... and archives
    # by /api/comics/<id>/download; both authenticate first.
    RewriteRule ^uploads(/|$) - [F,L]

    # Keep one canonical production origin. The host checks ensure local and
    # staging installations are unaffected by these redirects.
    RewriteCond %{HTTP_HOST} ^www\.comics\.starbugstone\.com$ [NC]
    RewriteRule ^ https://comics.starbugstone.com%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^comics\.starbugstone\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://comics.starbugstone.com%{REQUEST_URI} [R=301,L,NE]

    # Determine the RewriteBase automatically and set it as environment
    # variable. If you are using Apache aliases to do mass virtual hosting or
    # installing the project in a subdirectory, the base path will be prepended
    # to allow proper resolution of the index.php file and to redirect the user.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Sets the HTTP_AUTHORIZATION header removed by Apache.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Redirect to URI without front controller to prevent duplicate content.
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # If the requested filename exists (an asset, an image, the SPA's index.html...),
    # let Apache serve it directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ads.txt is generated from the configured publisher id, so it is a Symfony
    # route rather than a file on disk. Without this it falls through to the SPA
    # rule below and answers the IAB crawler with the React application, which
    # reads as "this domain declares no authorised seller".
    RewriteRule ^ads\.txt$ %{ENV:BASE}/index.php [QSA,L]

    # Client-side routes belong to the React SPA. Keep API requests on
    # Symfony, but send any other missing path (for example /admin or /library)
    # to the built index.html so React Router can resolve it. This must remain
    # after the real file/directory rule above and before the Symfony catch-all.
    RewriteCond %{REQUEST_URI} !^/api(?:/|$) [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ %{ENV:BASE}/index.html [L]

    # API requests and any other backend route still go through Symfony.
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        # When mod_rewrite is unavailable, redirect missing URLs to the front controller.
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>

# =============================================================================
# Hardening
# =============================================================================

# Belt and braces for anything that lands outside /uploads/: file types that
# must never be served from anywhere in the document root, whatever the rewrite
# rules do.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(env|env\..*|ini|log|sql|tar|gz|bak|swp|cbz|cbr|zip)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Disable directory listing.
Options -Indexes

# Send security headers if mod_headers is available.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
    # Symfony serves every HTML route and sets its Content-Security-Policy there,
    # so the nonce in the header is the same one injected into the Vite scripts.
    # A static Apache header here would intersect with and break that policy.
</IfModule>
