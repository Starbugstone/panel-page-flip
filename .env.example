# Template for the per-checkout .env. Do not edit this file to change your local
# setup — run `scripts/dev-env.sh`, which writes .env from this template with a
# project name, port block and UID/GID that belong to this checkout alone.
#
# .env itself is untracked on purpose. It used to be committed, which pinned
# every checkout to the same COMPOSE_PROJECT_NAME and the same ports: git
# worktrees and the main repo all resolved to one Docker Compose project, so
# whichever checkout ran `docker compose up` last owned the containers and every
# other checkout silently ran its tests against that one's source tree.

# Docker configuration
# Unique per checkout. Two checkouts sharing this value share containers.
COMPOSE_PROJECT_NAME=cbz_reader

# Host identity the containers run as, so files they create in the bind-mounted
# source tree are owned by you rather than by root.
HOST_UID=1000
HOST_GID=1000

# Ports
NGINX_PORT=8080
ADMINER_PORT=8081
FRONTEND_DEV_PORT=3001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# MYSQL_PORT is commented out to avoid port binding issues
# MYSQL_PORT=3308

# Database configuration
MYSQL_DATABASE=cbz_reader
MYSQL_USER=cbz_user
MYSQL_PASSWORD=cbz_password
MYSQL_ROOT_PASSWORD=root_password

# PHP configuration
PHP_VERSION=8.2
NGINX_VERSION=1.25

# Frontend configuration
APP_URL=http://localhost:8080
NODE_VERSION=22
