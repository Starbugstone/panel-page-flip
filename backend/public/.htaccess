# Set the default handler to index.php and index.html
DirectoryIndex index.php index.html

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Handle Authorization header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    
    # Uploaded comics and generated covers live under this document root, but
    # they are private: who may read a comic is decided per request by the
    # voter behind /api/comics. The rule below serves any file that exists
    # straight off the filesystem, which would hand the source file to anyone
    # who guesses its path and never ask who they are. Deny the whole tree
    # first — nothing legitimate reads it directly, since covers are served by
    # /api/comics/cover and pages by /api/comics/{id}/pages.
    RewriteRule ^uploads(/|$) - [F,L]

    # Redirect to remove trailing slash
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # If the requested resource exists as a file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # For API routes, forward to index.php
    RewriteRule ^api(/.*)?$ index.php [QSA,L]

    # ads.txt is generated from the configured publisher id, so it is a Symfony
    # route rather than a file on disk. Without this it would fall through to
    # index.html below and answer the IAB crawler with the React application.
    RewriteRule ^ads\.txt$ index.php [QSA,L]
    
    # For all other routes, try to serve the file directly, otherwise use index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [QSA,L]
</IfModule>

# Set some headers for security and caching
<IfModule mod_headers.c>
    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Cache control for static assets
    <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|js|css|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>
