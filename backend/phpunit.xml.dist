<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         convertDeprecationsToExceptions="false"
         cacheResultFile=".phpunit.cache/test-results"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <!--
            The whole suite runs in one process and peaks around 250M, against
            a container limit of 256M — close enough that it exhausted memory
            partway through a run rather than reliably. Raised here, where it
            applies to whoever runs the tests, rather than in the image, so it
            does not quietly become production's limit too.
        -->
        <ini name="memory_limit" value="512M" />
        <server name="APP_ENV" value="test" force="true" />
        <!--
            Docker passes APP_URL into the container, and Dotenv::bootEnv() does
            not override a real environment variable — so .env.test's value lost
            to whatever the developer's stack publishes. That is per checkout
            now (scripts/dev-env.sh), which made every canonical-URL assertion
            fail in a worktree while passing in the main repo. Forced here so
            the suite is hermetic wherever it runs.

            <env>, not <server>: php.ini here sets variables_order=EGPCS, so the
            container's value is in $_ENV, and that is the first place Symfony's
            env-var processor looks.
        -->
        <env name="APP_URL" value="http://localhost:8080" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="SYMFONY_PHPUNIT_REMOVE" value="" />
        <server name="SYMFONY_PHPUNIT_VERSION" value="9.5" />
        <server name="KERNEL_CLASS" value="App\Kernel" />
    </php>

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>

    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory>src/Kernel.php</directory>
            <directory>src/DependencyInjection</directory>
        </exclude>
    </coverage>

    <listeners>
        <listener class="Symfony\Bridge\PhpUnit\SymfonyTestsListener" />
    </listeners>

    <extensions>
        <extension class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
    </extensions>
</phpunit>
