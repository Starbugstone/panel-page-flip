# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev

# Off for the local stack only: development signs the same accounts in over and
# over from one Docker IP. It defaults to on everywhere it is not set, so a
# deployment has to disable it deliberately rather than by inheriting APP_ENV.
LOGIN_RATE_LIMIT_ENABLED=0
APP_SECRET=ChangeMeInEnvLocal
APP_DATA_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APP_URL=http://localhost:8080
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url

# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
# MYSQL_USER=${MYSQL_USER:-cbz_user}
# MYSQL_PASSWORD=${MYSQL_PASSWORD:-cbz_password}
# MYSQL_DATABASE=${MYSQL_DATABASE:-cbz_reader}
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

# =============================================================================
# REVERSE PROXY
# =============================================================================
# Comma-separated list of proxy addresses to trust for X-Forwarded-* headers.
# Leave empty when Nginx talks to PHP-FPM directly (the Docker setup).
# Set it when the app sits behind an extra proxy or CDN (e.g. Cloudflare),
# otherwise per-IP rate limiting sees every visitor as the same address.
# Example: TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_PROXIES=

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
MAILER_TRANSPORT=sync
MAILER_FROM_ADDRESS=do-not-reply@comicreader.com
MAILER_FROM_NAME="Panel Page Flip"

# =============================================================================
# PUBLIC APPLICATION URL
# =============================================================================
# APP_URL above is the one same-origin base URL for browser and backend links.

# =============================================================================
# UPLOAD CONFIGURATION
# =============================================================================
MAX_CONCURRENT_UPLOADS=6
MAX_PARALLEL_FILE_UPLOADS=4
# Canonical comic bytes allowed per account. 0 disables the application-level
# quota and leaves available disk space as the only storage limit.
UPLOAD_USER_QUOTA_BYTES=10737418240

# =============================================================================
# DROPBOX INTEGRATION CONFIGURATION
# =============================================================================
# Dropbox App Credentials (get from https://www.dropbox.com/developers/apps)
DROPBOX_APP_KEY=xxx
DROPBOX_APP_SECRET=xxx

# Dropbox OAuth Redirect URI (must match exactly in Dropbox app settings)
DROPBOX_REDIRECT_URI=http://localhost:8080/api/dropbox/callback

# Dropbox App Folder Configuration
# This is the folder path in each user's Dropbox where comics will be synced from
# Default: /Apps/StarbugStoneComics (created automatically when users connect)
DROPBOX_APP_FOLDER=/Apps/StarbugStoneComics

# Dropbox Import Configuration
# Maximum number of files to sync per user per sync operation (prevents overload)
DROPBOX_SYNC_LIMIT=10

# Dropbox Rate Limiting (requests per minute to prevent API limits)
DROPBOX_RATE_LIMIT=60

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# Uncomment and modify these for local development if needed:
# DROPBOX_APP_KEY=your_dev_app_key
# DROPBOX_APP_SECRET=your_dev_app_secret
# DROPBOX_REDIRECT_URI=http://localhost:8080/api/dropbox/callback
# APP_URL=http://localhost:8080

# =============================================================================
# PRODUCTION NOTES
# =============================================================================
# For production deployment:
# 1. Set DROPBOX_APP_KEY and DROPBOX_APP_SECRET to your production values
# 2. Update DROPBOX_REDIRECT_URI to your production domain
# 3. Update APP_URL to your production public URL
# 4. Consider using environment-specific .env files (.env.prod)
# 5. Never commit production secrets to version control

# =============================================================================
# ADVERTISING — optional, off by default
# =============================================================================
# Two settings, and no more: which ad formats run, which pages are excluded and
# whether the bulk-upload Offerwall appears are all configured in the AdSense
# account, not here. docs/advertising.md has the console checklist.
#
# Advertising never gates anything. With it off — the default, and what every
# development, test and ordinary self-hosted installation should keep — no
# Google script is loaded, no consent panel appears, and bulk upload opens
# directly.
#
# ADSENSE_CLIENT is the publisher id from your own AdSense account, in the form
# ca-pub- followed by 16 digits. Enabling this with a missing or malformed id
# logs a warning and leaves advertising off.
#
# Google publishes no sandbox publisher id for AdSense on the web, and no way
# for a page to mark Auto Ads as test placements — so there is nothing to paste
# in here for a trial run, and pointing your real account at a development
# machine records real impressions on traffic nobody made. That is the pattern
# AdSense suspends accounts over, so leave this off outside production.
ADSENSE_ENABLED=false
ADSENSE_CLIENT=

# =============================================================================
# SECURITY / AUDIT LOGGING
# =============================================================================
# Where the files go and how long they are kept is documented in
# docs/security-logging.md. Deletion is not automatic: `app:cleanup-logs`
# applies these numbers and has to be scheduled.
#
# Daily files under var/log/app/YYYY-MM-DD.log — ordinary application logs.
APP_LOG_RETENTION_DAYS=30
# Daily files under var/log/security/YYYY/MM/YYYY-MM-DD.log. A year, because a
# security question is usually asked long after the event.
SECURITY_LOG_RETENTION_DAYS=365
# Daily files under var/log/audit/YYYY/MM/YYYY-MM-DD.log.
AUDIT_LOG_RETENTION_DAYS=365
# Closed/rejected content reports are removed after this bounded period unless
# an administrator placed the case on legal hold. Schedule
# `app:cleanup-content-reports` alongside the other retention commands.
CONTENT_REPORT_RETENTION_DAYS=730

# =============================================================================
# SHARING
# =============================================================================
# How long a C- comic code or G- group code stays redeemable after it is
# created. Applies to codes issued from the moment it changes and never
# retroactively: an owner who told somebody their code works until Friday must
# not find that this setting moved Friday. U- user codes are unaffected — they
# identify a person rather than granting access, and live until rotated.
SHARE_CONTENT_CODE_TTL_DAYS=7

# Where share invitation notices are handled. `sync://` sends them inline, in
# the same request that created the shares — which needs no worker and is the
# right default, because nothing else in this application puts a message on a
# queue and an instance without a worker would create shares and silently never
# tell anybody.
#
# The guarantee the design actually needs holds either way: the notice is
# dispatched after the shares commit, so a mail server having a bad minute
# costs a notification and never a share, and Resend recovers it.
#
# Switch to the queue once `messenger:consume share_notifications` is running as
# a service — that adds automatic retry and stops the request waiting on SMTP:
#   SHARE_NOTIFICATION_TRANSPORT_DSN=doctrine://default?auto_setup=0
SHARE_NOTIFICATION_TRANSPORT_DSN=sync://

# Optional dedicated legal mailbox. When omitted, the privacy contact (and then
# MAILER_FROM_ADDRESS) is used.
# LEGAL_EMAIL=legal@example.com

# Administrator email alerts. Off by default: an instance with no reachable
# mailbox should not be trying to send these, and every event is logged either
# way. Turn on once SECURITY_ALERT_EMAILS is set and MAILER_DSN really delivers.
SECURITY_ALERTS_ENABLED=0
# Comma-separated. An operational address is preferred over an administrator's
# personal one — the account may be the thing that has been compromised. If this
# is empty and alerts are on, verified ROLE_ADMIN account addresses are used.
SECURITY_ALERT_EMAILS=
# Deduplication window. One message per event class per source per window,
# carrying the number of occurrences rather than one message each.
SECURITY_ALERT_WINDOW_MINUTES=15
# Failed logins from one address within the window before an alert is sent.
SECURITY_ALERT_FAILED_LOGIN_THRESHOLD=10
# Refused requests from one account or address within the window before an
# alert is sent. Admin endpoints and age-gate bypasses use tighter counts of
# their own.
SECURITY_ALERT_AUTHZ_THRESHOLD=10

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> metadata providers ###
# The operator's final word on the provider integrations. Nothing inside the
# application can override these.
#
# Shared Metron is off unless set: it spends a token this installation owns, so
# it is opted into rather than inherited. A user with a personal Metron token in
# their settings is unaffected by it, and so is metadata read from the comics
# themselves.
METRON_SHARED_ENABLED=false
# Comic Vine's published API terms are non-commercial use only. A self-hosted
# personal library is inside those terms, so this is on by default; turn it off
# if this deployment stops being. It governs this server's own key — a user who
# adds their own uses that instead, unless an administrator has turned personal
# tokens off from Admin -> Metadata.
COMIC_VINE_SHARED_ENABLED=true
###< metadata providers ###
