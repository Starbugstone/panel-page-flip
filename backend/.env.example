# =============================================================================
# Panel Page Flip — backend environment template
# =============================================================================
# Every variable the Symfony application reads is listed here, with example
# values only. Nothing in this file is a real credential.
#
# How to use it:
#   * Docker development — the root .env and backend/.env already supply working
#     defaults. Copy this file to backend/.env.local only for the values you
#     need to override on your machine (secrets, a different mailer, Dropbox).
#   * Bare-metal / shared hosting — copy it to backend/.env.prod.local and
#     replace every value. See SSH-deploy.md and deploy.md.
#
# .env.local and .env.*.local are gitignored. Real environment variables always
# win over these files, so a container variable overrides anything set here.
# Never commit a filled-in copy.

# =============================================================================
# CORE — required
# =============================================================================
# dev enables the profiler and verbose errors; use prod for anything reachable
# from the internet.
APP_ENV=dev

# Brute-force protection on POST /api/login: five attempts per fifteen minutes.
# Leave it on for anything reachable from the internet, whatever APP_ENV says.
# Set it to 0 only on a local development machine, where repeatedly signing the
# same test account in from one address would block nobody but you.
LOGIN_RATE_LIMIT_ENABLED=1
APP_DEBUG=1

# Signs cookies and CSRF tokens.  Generate with: openssl rand -hex 32
APP_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Encrypts stored integration credentials (Dropbox and metadata-provider credentials).
# Generate once with: openssl rand -base64 32
# Preserve it across deploys — rotating it makes existing tokens unreadable.
APP_DATA_KEY=ZXhhbXBsZS1rZXktcmVwbGFjZS1tZS13aXRoLXJhbmRvbQ==

# The one public same-origin URL: emails, OAuth redirects, canonical metadata,
# robots.txt and sitemap.xml are all built from it. No trailing slash, no path.
APP_URL=https://comics.example.com

# =============================================================================
# DATABASE — required
# =============================================================================
# Match serverVersion to the real server (SELECT VERSION();) or Doctrine will
# generate migrations for the wrong platform.
DATABASE_URL="mysql://comics_user:example_password@127.0.0.1:3306/cbz_reader?serverVersion=8.0.32&charset=utf8mb4"

# =============================================================================
# BROWSER ACCESS — required
# =============================================================================
# Regex, in the format nelmio/cors-bundle expects. Because the application is
# served same-origin, this only needs to list its own public origin.
# Development default: '^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
CORS_ALLOW_ORIGIN=^https://comics\.example\.com$

# Comma-separated proxies to trust for X-Forwarded-* headers. Leave empty when
# Nginx talks straight to PHP-FPM (the Docker setup). Set it behind an extra
# proxy or CDN, otherwise per-IP rate limiting sees every visitor as one address.
# Example: TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_PROXIES=

# =============================================================================
# EMAIL — required for registration, verification, password reset and sharing
# =============================================================================
# Docker development uses Mailpit: MAILER_DSN=smtp://mailpit:1025
# Discard mail entirely with: MAILER_DSN=null://null
MAILER_DSN=smtp://smtp_user:example_password@smtp.example.com:587
MAILER_TRANSPORT=smtp
MAILER_FROM_ADDRESS=noreply@example.com
MAILER_FROM_NAME="Panel Page Flip"

# =============================================================================
# PRIVACY — optional, shown on the legal pages and in GDPR responses
# =============================================================================
# Defaults to "Panel Page Flip site operator" and to MAILER_FROM_ADDRESS.
PRIVACY_OPERATOR="Panel Page Flip site operator"
PRIVACY_EMAIL=privacy@example.com

# =============================================================================
# UPLOADS — optional
# =============================================================================
# Concurrent upload HTTP requests shared by the whole batch. Keep this below
# the available PHP-FPM worker count so completion and normal API traffic still
# have capacity. The shipped Docker pool has five workers, so this defaults to 4.
MAX_CONCURRENT_UPLOADS=4

# =============================================================================
# ADVERTISING — optional, off by default
# =============================================================================
# Two settings, and no more: which ad formats run, which pages are excluded and
# whether the bulk-upload Offerwall appears are all configured in the AdSense
# account, not here. docs/advertising.md has the console checklist.
#
# Advertising never gates anything. With it off — the default, and what every
# development, test and ordinary self-hosted installation should keep — no
# Google script is loaded, no consent panel appears, and bulk upload opens
# directly.
#
# ADSENSE_CLIENT is the publisher id from your own AdSense account, in the form
# ca-pub- followed by 16 digits. Enabling this with a missing or malformed id
# logs a warning and leaves advertising off.
#
# Google publishes no sandbox publisher id for AdSense on the web, and no way
# for a page to mark Auto Ads as test placements — so there is nothing to paste
# in here for a trial run, and pointing your real account at a development
# machine records real impressions on traffic nobody made. That is the pattern
# AdSense suspends accounts over, so leave this off outside production.
ADSENSE_ENABLED=false
ADSENSE_CLIENT=

# =============================================================================
# DROPBOX SYNC — optional, leave the credentials empty to disable the feature
# =============================================================================
# Register an app at https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Must match the redirect URI configured on the Dropbox app, character for
# character. Normally APP_URL + /api/dropbox/callback.
DROPBOX_REDIRECT_URI=https://comics.example.com/api/dropbox/callback
# Folder inside each user's Dropbox that comics are synced from.
DROPBOX_APP_FOLDER=/Apps/StarbugStoneComics
# Files imported per user per sync run, and requests per minute.
DROPBOX_SYNC_LIMIT=10
DROPBOX_RATE_LIMIT=60

# The operator's final word on the provider integrations. Nothing inside the
# application can override these.
#
# Shared Metron is off unless set: it spends a token this installation owns, so
# it is opted into rather than inherited. A user with a personal Metron token in
# their settings is unaffected by it, and so is metadata read from the comics
# themselves.
METRON_SHARED_ENABLED=false
# Comic Vine's published API terms are non-commercial use only. A self-hosted
# personal library is inside those terms, so this is on by default; turn it off
# if this deployment stops being. It governs this server's own key — a user who
# adds their own uses that instead, unless an administrator has turned personal
# tokens off from Admin -> Metadata.
COMIC_VINE_SHARED_ENABLED=true

# =============================================================================
# SHARING
# =============================================================================
# How long a C- comic code or G- group code stays redeemable after it is
# created. Applies to codes issued from the moment it changes and never
# retroactively: an owner who told somebody their code works until Friday must
# not find that this setting moved Friday. U- user codes are unaffected — they
# identify a person rather than granting access, and live until rotated.
SHARE_CONTENT_CODE_TTL_DAYS=7

# Where share invitation notices are handled. `sync://` sends them inline, in
# the same request that created the shares — which needs no worker and is the
# right default, because nothing else in this application puts a message on a
# queue and an instance without a worker would create shares and silently never
# tell anybody.
#
# The guarantee the design actually needs holds either way: the notice is
# dispatched after the shares commit, so a mail server having a bad minute
# costs a notification and never a share, and Resend recovers it.
#
# Switch to the queue once `messenger:consume share_notifications` is running as
# a service — that adds automatic retry and stops the request waiting on SMTP:
#   SHARE_NOTIFICATION_TRANSPORT_DSN=doctrine://default?auto_setup=0
SHARE_NOTIFICATION_TRANSPORT_DSN=sync://

# =============================================================================
# SECURITY / AUDIT LOGGING — optional, the defaults are the documented policy
# =============================================================================
# Retention is policy only. Deletion is not automatic: `app:cleanup-logs`
# applies these numbers and has to be scheduled daily, or nothing is ever
# removed. Full guide: docs/security-logging.md
#
# Daily files under var/log/app/YYYY-MM-DD.log — ordinary application logs.
APP_LOG_RETENTION_DAYS=30
# Daily files under var/log/security/YYYY/MM/. A year, because a security
# question is usually asked long after the event.
SECURITY_LOG_RETENTION_DAYS=365
# Daily files under var/log/audit/YYYY/MM/.
AUDIT_LOG_RETENTION_DAYS=365

# Administrator email alerts. Off by default: an instance with no reachable
# mailbox should not be trying to send these, and every event is logged either
# way. Turn on once SECURITY_ALERT_EMAILS is set and MAILER_DSN really delivers.
SECURITY_ALERTS_ENABLED=0
# Comma-separated. An operational address is preferred over an administrator's
# personal one — that account may be the thing that has been compromised. If
# this is empty and alerts are on, verified ROLE_ADMIN addresses are used.
SECURITY_ALERT_EMAILS=
# Deduplication window. One message per event class per source per window,
# carrying the number of occurrences rather than one message each.
SECURITY_ALERT_WINDOW_MINUTES=15
# Failed logins from one source within the window before an alert is sent.
SECURITY_ALERT_FAILED_LOGIN_THRESHOLD=10
# Refused requests from one account or address within the window before an
# alert is sent. Admin endpoints and age-gate bypasses use tighter counts of
# their own.
SECURITY_ALERT_AUTHZ_THRESHOLD=10

# =============================================================================
# CONTENT REPORTS — optional
# =============================================================================
# Public operational legal contact and reply-to for /report-content. Falls back
# to PRIVACY_EMAIL, then MAILER_FROM_ADDRESS. Do not use a personal address.
# See docs/content-reporting.md
#LEGAL_EMAIL=legal@example.com

# Closed and rejected reports older than this are eligible for deletion by
# `app:cleanup-content-reports`. Open cases and cases on legal hold are never
# selected. Schedule it alongside the other retention commands.
CONTENT_REPORT_RETENTION_DAYS=730

# =============================================================================
# INFRASTRUCTURE — optional, the defaults suit both Docker and shared hosting
# =============================================================================
# Queue transport. doctrine:// keeps everything in the existing database.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Locking store. flock uses the local filesystem and needs no extra service.
LOCK_DSN=flock

# =============================================================================
# TOOLING — optional, never needed in production
# =============================================================================
# Base URL that `php bin/console app:test-api-endpoints` sends its HTTP probes
# to. APP_URL is the public address, which the PHP container itself may not be
# able to reach; inside Docker Compose the web server is http://nginx.
APP_INTERNAL_URL=http://nginx

# =============================================================================
# DEPLOYMENT — production only
# =============================================================================
# Authorises the post-deploy migration runner (scripts/deploy/_post-deploy.php).
# Must equal POST_DEPLOY_TOKEN in scripts/.env.deploy, and is rotated on every
# deploy. Generate with: openssl rand -hex 32
DEPLOY_TOKEN=replace-me-with-openssl-rand-hex-32

# How long the optional qpdf structural check on a PDF may take, per document.
# Set to 0 to disable it. See docs/comic-formats.md.
#PDF_STRUCTURE_CHECK_BUDGET_SECONDS=8.0

# What that check costs per megabyte on YOUR server. The default was measured on
# a development container, so this is the number worth correcting on real
# hardware. Budget divided by rate is the largest document that gets checked —
# 8.0 / 0.4 = 20 MB. Raise the rate if your disk is slower, lower it if faster.
# `php bin/console app:comic-formats:check` reports the resulting threshold.
#PDF_STRUCTURE_CHECK_SECONDS_PER_MEGABYTE=0.4
