# =============================================================================
# Panel Page Flip — backend environment template
# =============================================================================
# Every variable the Symfony application reads is listed here, with example
# values only. Nothing in this file is a real credential.
#
# How to use it:
#   * Docker development — the root .env and backend/.env already supply working
#     defaults. Copy this file to backend/.env.local only for the values you
#     need to override on your machine (secrets, a different mailer, Dropbox).
#   * Bare-metal / shared hosting — copy it to backend/.env.prod.local and
#     replace every value. See SSH-deploy.md and deploy.md.
#
# .env.local and .env.*.local are gitignored. Real environment variables always
# win over these files, so a container variable overrides anything set here.
# Never commit a filled-in copy.

# =============================================================================
# CORE — required
# =============================================================================
# dev enables the profiler and verbose errors; use prod for anything reachable
# from the internet.
APP_ENV=dev
APP_DEBUG=1

# Signs cookies and CSRF tokens.  Generate with: openssl rand -hex 32
APP_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Encrypts stored integration credentials (Dropbox and metadata-provider credentials).
# Generate once with: openssl rand -base64 32
# Preserve it across deploys — rotating it makes existing tokens unreadable.
APP_DATA_KEY=ZXhhbXBsZS1rZXktcmVwbGFjZS1tZS13aXRoLXJhbmRvbQ==

# The one public same-origin URL: emails, OAuth redirects, canonical metadata,
# robots.txt and sitemap.xml are all built from it. No trailing slash, no path.
APP_URL=https://comics.example.com

# =============================================================================
# DATABASE — required
# =============================================================================
# Match serverVersion to the real server (SELECT VERSION();) or Doctrine will
# generate migrations for the wrong platform.
DATABASE_URL="mysql://comics_user:example_password@127.0.0.1:3306/cbz_reader?serverVersion=8.0.32&charset=utf8mb4"

# =============================================================================
# BROWSER ACCESS — required
# =============================================================================
# Regex, in the format nelmio/cors-bundle expects. Because the application is
# served same-origin, this only needs to list its own public origin.
# Development default: '^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
CORS_ALLOW_ORIGIN=^https://comics\.example\.com$

# Comma-separated proxies to trust for X-Forwarded-* headers. Leave empty when
# Nginx talks straight to PHP-FPM (the Docker setup). Set it behind an extra
# proxy or CDN, otherwise per-IP rate limiting sees every visitor as one address.
# Example: TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_PROXIES=

# =============================================================================
# EMAIL — required for registration, verification, password reset and sharing
# =============================================================================
# Docker development uses Mailpit: MAILER_DSN=smtp://mailpit:1025
# Discard mail entirely with: MAILER_DSN=null://null
MAILER_DSN=smtp://smtp_user:example_password@smtp.example.com:587
MAILER_TRANSPORT=smtp
MAILER_FROM_ADDRESS=noreply@example.com
MAILER_FROM_NAME="Panel Page Flip"

# =============================================================================
# PRIVACY — optional, shown on the legal pages and in GDPR responses
# =============================================================================
# Defaults to "Panel Page Flip site operator" and to MAILER_FROM_ADDRESS.
PRIVACY_OPERATOR="Panel Page Flip site operator"
PRIVACY_EMAIL=privacy@example.com

# =============================================================================
# UPLOADS — optional
# =============================================================================
# Parallel chunk uploads allowed per user. Defaults to 5.
MAX_CONCURRENT_UPLOADS=5

# =============================================================================
# DROPBOX SYNC — optional, leave the credentials empty to disable the feature
# =============================================================================
# Register an app at https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Must match the redirect URI configured on the Dropbox app, character for
# character. Normally APP_URL + /api/dropbox/callback.
DROPBOX_REDIRECT_URI=https://comics.example.com/api/dropbox/callback
# Folder inside each user's Dropbox that comics are synced from.
DROPBOX_APP_FOLDER=/Apps/StarbugStoneComics
# Files imported per user per sync run, and requests per minute.
DROPBOX_SYNC_LIMIT=10
DROPBOX_RATE_LIMIT=60

# The operator's final word on the provider integrations. Nothing inside the
# application can override these.
#
# Shared Metron is off unless set: it spends a token this installation owns, so
# it is opted into rather than inherited. A user with a personal Metron token in
# their settings is unaffected by it, and so is metadata read from the comics
# themselves.
METRON_SHARED_ENABLED=false
# Comic Vine's published API terms are non-commercial use only. A self-hosted
# personal library is inside those terms, so this is on by default; turn it off
# if this deployment stops being. It governs this server's own key — a user who
# adds their own uses that instead, unless an administrator has turned personal
# tokens off from Admin -> Metadata.
COMIC_VINE_SHARED_ENABLED=true

# =============================================================================
# INFRASTRUCTURE — optional, the defaults suit both Docker and shared hosting
# =============================================================================
# Queue transport. doctrine:// keeps everything in the existing database.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Locking store. flock uses the local filesystem and needs no extra service.
LOCK_DSN=flock

# =============================================================================
# TOOLING — optional, never needed in production
# =============================================================================
# Base URL that `php bin/console app:test-api-endpoints` sends its HTTP probes
# to. APP_URL is the public address, which the PHP container itself may not be
# able to reach; inside Docker Compose the web server is http://nginx.
APP_INTERNAL_URL=http://nginx

# =============================================================================
# DEPLOYMENT — production only
# =============================================================================
# Authorises the post-deploy migration runner (scripts/deploy/_post-deploy.php).
# Must equal POST_DEPLOY_TOKEN in scripts/.env.deploy, and is rotated on every
# deploy. Generate with: openssl rand -hex 32
DEPLOY_TOKEN=replace-me-with-openssl-rand-hex-32
