{
  "_comment": "Shared CSP inputs. Advertising-enabled HTML receives a fresh nonce from Symfony (Apache) or nginx's request id (container), and script-src follows Google's supported strict-CSP shape. Non-script directives stay on audited origins rather than broad wildcards.",
  "directives": {
    "default-src": ["'self'"],
    "object-src": ["'none'"],
    "base-uri": ["'none'"],
    "img-src": [
      "'self'",
      "data:",
      "blob:",
      "https://pagead2.googlesyndication.com",
      "https://googleads.g.doubleclick.net",
      "https://tpc.googlesyndication.com",
      "https://www.google.com"
    ],
    "style-src": ["'self'", "'unsafe-inline'"],
    "frame-src": [
      "'self'",
      "https://googleads.g.doubleclick.net",
      "https://tpc.googlesyndication.com",
      "https://www.google.com",
      "https://fundingchoicesmessages.google.com"
    ],
    "connect-src": [
      "'self'",
      "https://pagead2.googlesyndication.com",
      "https://googleads.g.doubleclick.net",
      "https://fundingchoicesmessages.google.com",
      "https://ep1.adtrafficquality.google",
      "https://ep2.adtrafficquality.google"
    ],
    "frame-ancestors": ["'none'"]
  },
  "scriptSrcWithoutAdvertising": ["'self'"],
  "scriptSrcWithAdvertising": [
    "'nonce-{nonce}'",
    "'unsafe-inline'",
    "'unsafe-eval'",
    "'strict-dynamic'",
    "https:",
    "http:"
  ],
  "developmentAdditions": {
    "connect-src": ["ws:", "http://localhost:*"]
  }
}
