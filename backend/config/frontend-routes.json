{
  "indexable": [
    { "path": "/", "changefreq": "monthly", "priority": "1.0" },
    { "path": "/privacy", "changefreq": "yearly", "priority": "0.3" },
    { "path": "/terms", "changefreq": "yearly", "priority": "0.3" },
    { "path": "/cookies", "changefreq": "yearly", "priority": "0.3" },
    { "path": "/report-content", "changefreq": "yearly", "priority": "0.4" }
  ],
  "noindex": [
    "/login",
    "/complete-social-signup",
    "/forgot-password",
    "/email-verification",
    "/dashboard",
    "/upload",
    "/upload/bulk",
    "/upload/bulk/session",
    "/settings",
    "/admin",
    "/dropbox-sync",
    "/sharing"
  ],
  "googleFree": ["/privacy", "/cookies", "/terms"],
  "noindexPatterns": [
    "^/admin/users/[^/]+$",
    "^/reset-password/[^/]+$",
    "^/read/[^/]+$",
    "^/share/invitation/[^/]+$"
  ]
}
