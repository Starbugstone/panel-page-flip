# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
APP_DATA_KEY='test_app_data_key_change_in_real_envs'
SYMFONY_DEPRECATIONS_HELPER=disabled
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

# Test database — uses the same MySQL service but a separate schema (Doctrine appends "_test")
DATABASE_URL="mysql://${MYSQL_USER:-cbz_user}:${MYSQL_PASSWORD:-cbz_password}@database:3306/cbz_reader?serverVersion=8.0&charset=utf8mb4"

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=in-memory://
LOCK_DSN=flock

DROPBOX_APP_KEY=test_app_key
DROPBOX_APP_SECRET=test_app_secret
DROPBOX_REDIRECT_URI=http://localhost/dropbox/callback
DROPBOX_APP_FOLDER=/comics
DROPBOX_SYNC_LIMIT=3
DROPBOX_RATE_LIMIT=10
MAX_CONCURRENT_UPLOADS=3

FRONTEND_URL=http://localhost:3001
MAILER_FROM_ADDRESS=test@example.com
MAILER_FROM_NAME="Test Sender"
