
# Set environment for Symfony
APP_ENV=dev
APP_SECRET=your_app_secret_here
# The one public same-origin URL. Overrides the root .env value for local,
# non-Docker development.
APP_URL=http://localhost:8080

# Database defaults live in .env. Docker passes this checkout's MYSQL_* values
# as real environment variables, which take precedence over those defaults.

MAILER_DSN=smtp://mailpit:1025
MAILER_FROM_ADDRESS=do-not-reply@comicreader.com
MAILER_FROM_NAME="Panel Page Flip"

# CORS settings if needed
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
