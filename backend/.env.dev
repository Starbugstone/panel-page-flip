
# Set environment for Symfony
APP_ENV=dev
APP_SECRET=your_app_secret_here
# The one public same-origin URL. Overrides the root .env value for local,
# non-Docker development.
APP_URL=http://localhost:8080

# Database configuration
DATABASE_URL="mysql://cbz_user:cbz_password@database:3306/cbz_reader?serverVersion=8.0"

MAILER_DSN=smtp://mailpit:1025
MAILER_FROM_ADDRESS=noreply@comicreader.com
MAILER_FROM_NAME="Comic Reader"

# CORS settings if needed
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
